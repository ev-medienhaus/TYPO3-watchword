plugin.tx_watchword {
    # cat=plugin.tx_watchword/javascript; type=boolean; label=Include JavaScript: Load the Watchword frontend script (previous/next day via Ajax)
    includeJavascript = 0
    # cat=plugin.tx_watchword/css; type=boolean; label=Include CSS: Load the Watchword stylesheet (needed without the site frontend CSS)
    includeCss = 0
    settings {
        ajaxTypeNum = 1786976500
        # cat=plugin.tx_watchword/display; type=boolean; label=Show weekday and Sunday name: Render weekday and optional Sunday/holiday name next to the date
        showWeekdayAndSundayName = 0
    }
}